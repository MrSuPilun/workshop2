# Azure/OpenAI-compatible defaults. Copy this file to .env and add your key.
AZURE_OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-resource.cognitiveservices.azure.com/openai/v1/
SYNCSPACE_DEFAULT_MODEL=gpt-4o-mini

# Optional Google Gemini default
GOOGLE_API_KEY=
GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_MODEL=gemini-2.5-flash
