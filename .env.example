# Copy this file to .env and fill in the block for the provider you use.
# Every value only prefills the Settings page; nothing here is written to SQLite.

# --- Azure OpenAI (Settings -> provider "Azure OpenAI") ---------------------
# The endpoint must be the resource root. Do NOT append /openai or /openai/v1:
# the SDK adds /openai/deployments/<deployment>/... itself, and a doubled path
# is what makes Azure answer 404 "Resource not found".
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# In the Settings form, "Deployment name" is the name you gave the deployment in
# Azure AI Foundry, which is often not the same as the model name.

# --- OpenAI-compatible endpoints (provider "Other (OpenAI-compatible)") -----
# This one DOES take a full v1 surface, including Azure's v1 API if you prefer
# it over the Azure provider above. Setting it makes the app start on this
# provider instead of Azure.
OPENAI_BASE_URL=
SYNCSPACE_DEFAULT_MODEL=gpt-4o-mini

# --- OpenAI (provider "OpenAI") --------------------------------------------
OPENAI_API_KEY=

# --- Google Gemini (provider "Google Gemini") ------------------------------
GOOGLE_API_KEY=
GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_MODEL=gemini-2.5-flash
